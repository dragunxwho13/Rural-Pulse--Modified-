# Copy to .env. Everything works WITHOUT any key (rules-only mode, demo SMS outbox).

# ---- AI (optional): https://aistudio.google.com/apikey
# Enables: understanding of the 9 AI-assisted languages and messy input, translation of
# prescriptions / first aid into any of the 22 languages, and the live voice assistant.
GOOGLE_API_KEY=
# Leave the model names EMPTY: RuralPulse lists the models your key can use and picks the newest
# Flash / Live / TTS models automatically (Google retires old names often). Set one only to force it.
RP_LLM_MODEL=
RP_LIVE_MODEL=
RP_TTS_MODEL=
RP_LIVE_VOICE=Aoede
RP_LLM_TIMEOUT=15
RP_VOICE_AI=0                  # 0 = voice assistant in English/Hindi/Tamil with browser speech (no key). 1 = Gemini any-language voice
RP_VOICE_LANGS=en,hi,ta

# ---- Public address (used in SMS links to medicine cards), e.g. https://ruralpulse.onrender.com
RP_PUBLIC_URL=

# ---- SMS (optional). Without it, messages go to a demo outbox shown on the dashboard
# and login codes are shown on screen (RP_DEMO_OTP=1). Set RP_DEMO_OTP=0 in production.
RP_SMS_PROVIDER=               # msg91 | twilio
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=             # DLT-approved flow template with a ##message## variable
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RP_DEMO_OTP=1
RP_AUTH_SECRET=change-me       # signs staff login tokens

# ---- Maps: point these at your own instances for production traffic
RP_OVERPASS_URL=https://overpass-api.de/api/interpreter
RP_NOMINATIM_URL=https://nominatim.openstreetmap.org
RP_OSRM_URL=https://router.project-osrm.org
RP_USER_AGENT=RuralPulse/3.1 (your-email@example.com)
RP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png   # or https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
RP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# All of the above (and GOOGLE_API_KEY) can also be set from the website: ⚙ Settings, on the server computer.
RP_ALLOW_REMOTE_SETTINGS=0     # 1 = allow ⚙ Settings from other devices (only on a private network)

# ---- Other
RP_TZ=Asia/Kolkata
RP_AUDIT_LOG=1
RP_AUDIT_SALT=change-me
RP_DB_PATH=logs/ruralpulse.db
RP_CORS_ORIGINS=*
RP_SEED_DEMO=1                 # load sample reports so the dashboards are never empty (0 in production)
